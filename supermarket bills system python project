# BUTTONS
buttons = tk.Frame(root, bg="#F2F2F2")
buttons.pack(pady=8)

tk.Button(
    buttons,
    text="ADD PRODUCT",
    command=add,
    bg="#28A745",
    fg="white",
    font=("Arial", 11, "bold")
).grid(row=0, column=0, padx=5)

tk.Button(
    buttons,
    text="CLEAR",
    command=clear,
    bg="#DC3545",
    fg="white",
    font=("Arial", 11, "bold")
).grid(row=0, column=1, padx=5)


# SHOPPING
shopping = tk.Text(
    root,
    height=4,
    width=70,
    font=("Courier New", 10)
)
shopping.pack()


# TOTALS
sub = tk.Label(
    root, text="Subtotal    : Rs.0.00",
    font=("Arial", 12, "bold"),
    bg="#F2F2F2"
)
sub.pack()

tax = tk.Label(
    root, text="GST 5%      : Rs.0.00",
    font=("Arial", 12, "bold"),
    bg="#F2F2F2"
)
tax.pack()

total = tk.Label(
    root, text="Grand Total : Rs.0.00",
    font=("Arial", 15, "bold"),
    bg="#FFD966"
)
total.pack(pady=5)


# GENERATE BUTTON
tk.Button(
    root,
    text="GENERATE BILL + QR + WHATSAPP",
    command=generate,
    bg="#25D366",
    fg="white",
    font=("Arial", 12, "bold"),
    padx=15,
    pady=8
).pack(pady=7)


# RESULT
result = tk.Frame(root, bg="#F2F2F2")
result.pack(fill="both", expand=True, padx=20)


# BILL
left = tk.Frame(result, bg="#F2F2F2")
left.pack(side="left", fill="both", expand=True, padx=10)

tk.Label(
    left,
    text="GENERATED BILL",
    bg="#1F4E78",
    fg="white",
    font=("Arial", 12, "bold")
).pack(fill="x")

output = tk.Text(
    left,
    height=15,
    width=55,
    font=("Courier New", 9)
)
output.pack(pady=5, fill="both", expand=True)


# QR
right = tk.Frame(result, bg="#F2F2F2")
right.pack(side="right", fill="both", expand=True, padx=10)

tk.Label(
    right,
    text="BILL QR CODE",
    bg="#1F4E78",
    fg="white",
    font=("Arial", 12, "bold")
).pack(fill="x")

qr_area = tk.Frame(
    right,
    bg="white",
    width=350,
    height=350
)
qr_area.pack(pady=20)
qr_area.pack_propagate(False)

qr = tk.Label(
    qr_area,
    text="QR Code\nwill appear here",
    bg="white",
    font=("Arial", 12, "bold")
)
qr.pack(expand=True)

tk.Label(
    right,
    text="Scan this QR code to view the bill",
    bg="#F2F2F2",
    font=("Arial", 10, "bold")
).pack()


root.mainloop()
