import tkinter as tk
from tkinter import ttk, messagebox
from datetime import datetime
import random
import qrcode
import pyttsx3
import webbrowser
import urllib.parse
from PIL import Image, ImageTk

# PRODUCTS
products = {
    1: ("Aashirvaad Atta", 350),
    2: ("Tata Salt", 30),
    3: ("Amul Milk", 32),
    4: ("Fortune Oil", 180),
    5: ("Surf Excel", 120)
}

cart = []
voice = pyttsx3.init()


# ADD PRODUCT
def add():
    try:
        pid = int(product.get().split(" - ")[0])
        qty = int(quantity.get())

        if qty <= 0:
            raise ValueError

        name, price = products[pid]
        amount = price * qty
        cart.append((name, qty, amount))

        shopping.insert(
            tk.END,
            f"{name} x {qty} = Rs.{amount:.2f}\n"
        )
        update_total()

    except:
        messagebox.showerror("Error", "Enter valid quantity")


# TOTAL
def update_total():
    subtotal = sum(x[2] for x in cart)
    gst = subtotal * 0.05
    grand = round(subtotal + gst)

    sub.config(text=f"Subtotal    : Rs.{subtotal:.2f}")
    tax.config(text=f"GST 5%      : Rs.{gst:.2f}")
    total.config(text=f"Grand Total : Rs.{grand:.2f}")


# GENERATE BILL
def generate():
    if not cart:
        messagebox.showwarning("Warning", "Add product first")
        return

    name = customer.get().strip()
    mobile = phone.get().strip()

    if not name:
        messagebox.showwarning("Warning", "Enter customer name")
        return

    if not mobile.isdigit() or len(mobile) != 10:
        messagebox.showwarning("Warning", "Enter 10-digit mobile")
        return

    bill_id = random.randint(100000, 999999)
    subtotal = sum(x[2] for x in cart)
    gst = subtotal * 0.05
    grand = round(subtotal + gst)

    bill = f"""========== DMART BILL ==========

Bill ID  : {bill_id}
Customer : {name}
Mobile   : {mobile}
Date     : {datetime.now().strftime("%d-%m-%Y %H:%M:%S")}

PRODUCTS
--------------------------------
"""

    for pname, qty, amount in cart:
        bill += f"{pname} x {qty} = Rs.{amount:.2f}\n"

    bill += f"""--------------------------------
Subtotal    : Rs.{subtotal:.2f}
GST 5%      : Rs.{gst:.2f}
Grand Total : Rs.{grand:.2f}

Thank You! Visit Again.
"""

    # SHOW BILL
    output.delete("1.0", tk.END)
    output.insert(tk.END, bill)

    # QR CODE
    qr_code = qrcode.QRCode(
        version=1,
        error_correction=qrcode.constants.ERROR_CORRECT_M,
        box_size=6,
        border=2
    )

    qr_code.add_data(bill)
    qr_code.make(fit=True)
    qr_code.make_image().save("bill_qr.png")

    # PILLOW QR SIZE
    img = Image.open("bill_qr.png")
    img = img.resize((270, 270), Image.Resampling.NEAREST)

    qr_img = ImageTk.PhotoImage(img)
    qr.config(image=qr_img, text="")
    qr.image = qr_img

    # VOICE
    voice.say(f"Your total bill is {grand} rupees")
    voice.runAndWait()

    # WHATSAPP
    url = (
        "https://web.whatsapp.com/send?"
        f"phone=91{mobile}&"
        f"text={urllib.parse.quote(bill)}"
    )
    webbrowser.open(url)

    messagebox.showinfo(
        "Success",
        f"Bill Generated!\nBill ID: {bill_id}"
    )


# CLEAR
def clear():
    cart.clear()
    shopping.delete("1.0", tk.END)
    output.delete("1.0", tk.END)

    customer.delete(0, tk.END)
    phone.delete(0, tk.END)

    quantity.delete(0, tk.END)
    quantity.insert(0, "1")

    sub.config(text="Subtotal    : Rs.0.00")
    tax.config(text="GST 5%      : Rs.0.00")
    total.config(text="Grand Total : Rs.0.00")

    qr.config(image="", text="QR Code\nwill appear here")
    qr.image = None


# WINDOW
root = tk.Tk()
root.title("DMART Billing System")
root.geometry("1000x750")
root.configure(bg="#F2F2F2")


# TITLE
tk.Label(
