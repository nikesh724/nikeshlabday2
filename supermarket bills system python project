phone = tk.Entry(frame, width=25, font=("Arial", 12))
phone.grid(row=1, column=1, padx=5, pady=5)


# PRODUCT
product = ttk.Combobox(
    root,
    width=35,
    state="readonly",
    values=[
        f"{i} - {n} - Rs.{p}"
