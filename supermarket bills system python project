    text="DMART SUPERMARKET BILLING SYSTEM",
    font=("Arial", 22, "bold"),
    bg="#1F4E78",
    fg="white",
    pady=12
).pack(fill="x")


# CUSTOMER
frame = tk.Frame(root, bg="#F2F2F2")
frame.pack(pady=10)

tk.Label(
    frame, text="Customer:",
    font=("Arial", 12, "bold"),
    bg="#F2F2F2"
